---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<a class="brand" href="/" aria-label="Khorscape home" data-compact={compact}>
  <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
    <path d="M11 39V9" />
    <path d="M35 10L17 25l18 13" />
    <path class="leaf-line" d="M28 12c7 2 10 8 9 16-7 1-13-2-16-8 2-4 4-6 7-8Z" />
    <path class="leaf-vein" d="M23 21c5-1 9 0 13 5" />
  </svg>
