---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<a class="brand" href="/" aria-label="Khorscape home" data-compact={compact}>
  {compact ? (
    <picture class="brand-logo brand-logo-mark" aria-hidden="true">
      <source type="image/webp" srcset="/brand/khorscape-mark-96.webp 96w, /brand/khorscape-mark-192.webp 192w" sizes="3rem" />
      <img src="/brand/khorscape-mark-192.png" alt="" width="192" height="174" loading="eager" decoding="async" />
    </picture>
  ) : (
    <picture class="brand-logo brand-logo-wordmark" aria-hidden="true">
      <source
        type="image/webp"
        srcset="/brand/khorscape-wordmark-320.webp 320w, /brand/khorscape-wordmark-640.webp 640w"
        sizes="(max-width: 420px) 8.8rem, 13rem"
      />
      <img src="/brand/khorscape-wordmark-640.png" alt="" width="640" height="179" loading="eager" decoding="async" />
    </picture>
  )}
  <span class="sr-only">Khorscape</span>
</a>
